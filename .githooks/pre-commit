#!/bin/sh
#
# Pre-commit checks for a public repository.
#
# 1. Machine-local absolute paths, which are useless to other clones and
#    permanent once pushed. See dev_docs/utils/check_no_local.py.
# 2. An optional machine-local hook, if the committer has installed one at
#    $GIT_DIR/hooks/pre-commit.local. Not tracked, not required, and absent on
#    a fresh clone; it exists so a contributor can add their own checks without
#    changing this file.
#
# Bypass:  git commit --no-verify
# Preferred over bypassing: waive the specific line (see the script's usage).

# A missing checker is a failure, not a skip: the script is tracked, so its
# absence means someone deleted it, and silently passing is the same defect the
# script itself guards against. A missing python3 is a skip, because that is a
# property of the committer's machine rather than of the commit.
if command -v python3 >/dev/null 2>&1; then
    if [ ! -f dev_docs/utils/check_no_local.py ]; then
        echo "pre-commit: dev_docs/utils/check_no_local.py is missing; refusing to pass silently" >&2
        exit 1
    fi
    python3 dev_docs/utils/check_no_local.py --staged || exit 1
else
    echo "pre-commit: python3 not found, path check SKIPPED (not run, not clean)" >&2
fi

LOCAL_HOOK="$(git rev-parse --git-dir)/hooks/pre-commit.local"
if [ -x "$LOCAL_HOOK" ]; then
    "$LOCAL_HOOK" || exit 1
fi

exit 0
